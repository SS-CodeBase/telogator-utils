# ==============================================================================
# Cohort Aggregation Configuration
# Copy this template, update the paths, and pass it to the aggregation shell script.
# ==============================================================================

# ---- Inputs ----
# This should point to the output directory generated by the previous step 
# (where the .all.chr.tal.summary.<mode>.tsv files are stored).
INPUT_DIR="/path/to/outputs/summary/TAL_summary/COHORT_NAME"

# ---- Outputs ----
# Root directory where the final aggregated master matrix will be saved.
OUTPUT_DIR="/path/to/outputs/summary/Aggregate_Output/COHORT_NAME"

# The specific file path and name for the final compiled matrix.
FINAL_OUTPUT="${OUTPUT_DIR}/COHORT_NAME.ref.tal.aggregate.summary_5_condn.tsv"

# ---- Pipeline Execution ----
# Absolute path to the core Python aggregation script
SCRIPT="/path/to/scripts/get_autosomes_tal_summary_stats_aggregated_4_multi_condn.py"
