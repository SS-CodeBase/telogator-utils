# ==============================================================================
# Telogator Summary Pipeline Configuration
# Copy this template, update the paths, and pass it to the submit script.
# ==============================================================================

# ---- Inputs ----
# Path to the TSV file mapping chromosome numbers to GenBank/RefSeq accessions
SPECIES_CHR_TABLE="/path/to/inputs/sample_cohort.ref.chr.mapping.tsv"

# Directory containing the raw *_tlens_by_allele.tsv files from Telogator
RAW_DIR="/path/to/inputs/raw_telogator_outputs/"

# ---- Outputs ----
# Root directory where per-sample summaries and logs will be saved
OUT_DIR="/path/to/outputs/summary/TAL_summary/"

# ---- Pipeline Execution ----
# Absolute path to the core Python processing script
SCRIPT="/path/to/scripts/get_tal_summary_stats.py"

# Number of parallel jobs to run (scales linearly with CPU cores available)
THREADS=8

# ---- Algorithmic Parameters ----
# Allele mode determines how many values are kept per chromosome arm:
#   'collapsed' : Selects the single allele with the highest read support.
#   'haplotype' : Retains the top two alleles (requires phase-aware inputs).
ALLELE_MODE="collapsed"
